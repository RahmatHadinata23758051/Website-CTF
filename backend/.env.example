# ==============================================================================
# RBLXSec Backend Environment Variables Template
# ==============================================================================
APP_ENV=development
PORT=8080

# Cryptographic Keys (Replace in production environments)
JWT_SECRET=change_this_development_secret
FLAG_SALT=change_this_development_salt

# Database Config (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rblxsec
DB_SSLMODE=disable

# Cache & Rate Limiting Config (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional Sample CTF Seeding (Set true to auto-seed challenges/hints on startup, false starts empty)
SEED_SAMPLE_DATA=false
