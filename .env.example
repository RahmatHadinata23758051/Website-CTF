# ==============================================================================
# CTF CHALLENGE PLATFORM ENVIRONMENT VARIABLES
# ==============================================================================

# Common Environment
APP_ENV=development # development, staging, production
PORT=8080

# Backend Configuration
BACKEND_PORT=8080
BACKEND_HOST=localhost
JWT_SECRET=supersecretjwtkeyreplaceinproduction123!
FLAG_SALT=ctfsaltvaluechangeinproduction456!

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ctfdb
DB_SSLMODE=disable

# Cache & Rate Limiting Configuration (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend Configuration
VITE_API_URL=http://localhost:8080
VITE_APP_NAME="CTF Challenge Platform"
